// This file gets rendered (via ERB, see hitobito core's lib/tasks/assets.rake)
// into hitobito core's app/assets/stylesheets_generated/ and compiled from
// there, so this wagon's own files have to be @import'ed by absolute path -
// `wagon_path` is this wagon's root, provided by the renderer. Core files are
// reachable as "hitobito/..." (core's app/assets/stylesheets is a dart-sass
// load path, see core's config/build_css.mjs).

// Bootstrap
@import "bootstrap/scss/functions";

// Agenda-only color tokens, must come before bootstrap/scss/variables so
// they can override Bootstrap's defaults for these pages only.
@import "<%= wagon_path.join("app", "assets", "stylesheets", "variables") %>";

@import "bootstrap/scss/variables";
@import "bootstrap/scss/maps";
@import "bootstrap/scss/utilities";
@import "bootstrap/scss/bootstrap";

// No FontAwesome import here: the agenda pages render every icon as an
// inline SVG (see AgendaIcon#to_svg), not from an icon font.

// Custom Stylesheets
// ui-datepicker before agenda.scss, so agenda.scss's own datepicker
// overrides (restyling it to match the rest of this page) win the cascade.
@import "hitobito/modules/ui-datepicker";
@import "<%= wagon_path.join("app", "assets", "stylesheets", "agenda") %>";
