- title t('.title')

- if event.course?
  = render 'event/participations/courses/signup', step: 1 do
    = render 'form', buttons_top: false, builder: WizardFormBuilder

- elsif event.tour?
  = render 'event/participations/tours/signup', step: 1 do
    = render 'form', buttons_top: false, builder: WizardFormBuilder

- else
  = render 'event/participations/step_wizard', step: 1
  = render 'form'
