%aside.card
  .card-body
    %h2.mb-2.card-title=t('.contact_title')
    .card-text=simple_format(t('.contact_text'))

    .card-text.mt-2
      = icon(:phone)
      %span.ms-1= t("global.sac.phone")
    .card-text
      = icon(:envelope)
      %span.ms-1= link_to(t("global.sac.contact_form_label"), t("global.sac.contact_form_url"), target: "_blank", rel: "noopener")
