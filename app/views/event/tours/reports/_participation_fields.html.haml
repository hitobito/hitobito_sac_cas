.row.d-none.d-xl-flex.fw-bold
  .col-2= Person.human_attribute_name(:name)
  .col-2= Role.model_name.human(count: 2)
  .col-2= Group::Sektion.model_name.human
  .col-3= Event::Participation.human_attribute_name(:status)
  .col-3= Event::Participation.human_attribute_name(:means_of_transport)

%hr.d-none.d-xl-block.m-0

- entry.participations.each do |participation|
  = f.fields_for :participations_attributes, participation, index: participation.id do |ff|
    .row.py-2
      .col-xl-2
        = ff.label(:name, Person.human_attribute_name(:name), class:"col-form-label d-xl-none")
        .fw-bold= link_to(participation.to_s(:list), group_event_participation_path(@group, @event, participation))
      .col-xl-2
        = ff.label(:roles, Role.model_name.human(count: 2), class:"col-form-label d-xl-none")
        .d-xl-block= participation.decorate.list_roles
      .col-xl-2
        = ff.label(:sektion, Group::Sektion.model_name.human, class:"col-form-label d-xl-none")
        .d-xl-block= participation.tour_sektion || t("global.associations.no_entry")
      .col-xl-3
        = ff.label(:state, class:"col-form-label d-xl-none")
        - if entry.report.event.canceled? || !entry.editable_participation_state?(participation)
          = participation.state_label
        - else
          = ff.i18n_enum_field :state, entry.participation_state_labels(participation), class: "d-block w-100"
      .col-xl-3
        = ff.label(:means_of_transport, class:"col-form-label d-xl-none")
        - if entry.report.event.canceled?
          = participation.means_of_transport_label
        - else
          = ff.i18n_enum_field :means_of_transport, Event::Participation.means_of_transport_labels.to_a, class: "d-block w-100"

    %hr.m-0
