= f.labeled(:tour_completed) do
  .col-form-label= format_attr(entry, :tour_completed?)
- if entry.report.event.canceled?
  = f.labeled(entry.report.event.class.human_attribute_name(:canceled_reason)) do
    .col-form-label= format_attr(entry.report.event, :canceled_reason)

= f.labeled_text_area(:review)
= f.labeled_text_area(:remarks)

= field_set_tag(t(".editing_status")) do
  = f.labeled(:submitter_id) do
    .col-form-label
      - if entry.report.submitter_id
        = format_attr(entry.report, :submitted_at)
        = t(".by")
        = format_attr(entry.report, :submitter_id)
      - else
        = "-"
  = f.labeled(:approver_id) do
    .col-form-label
      - if entry.report.approver_id
        = format_attr(entry.report, :approved_at)
        = t(".by")
        = format_attr(entry.report, :approver_id)
      - else
        = "-"
  = f.labeled(:payer_id) do
    .col-form-label
      - if entry.report.payer_id
        = format_attr(entry.report, :paid_at)
        = t(".by")
        = format_attr(entry.report, :payer_id)
      - else
        = "-"

- unless entry.report.status == :closed
  = field_set_tag(t(".status_change")) do
    %div{data: { controller: "field-visibility", "field-visibility-observed-field-id-value": "status_action_group", "field-visibility-hide-when-value": "keep" }}
      = f.labeled(t(".status_action")) do
        #status_action_group
          .form-check
            = f.radio_button(:status_action, "keep", class: "form-check-input")
            = f.label(:status_action, t(".keep"), value: "keep", class: "form-check-label")
          .form-check
            = f.radio_button(:status_action, "forward", class: "form-check-input")
            = f.label(:status_action, t(".forward.#{entry.report.status}"), value: "forward", class: "form-check-label")
          - unless entry.report.status == :draft
            .form-check
              = f.radio_button(:status_action, "reject", class: "form-check-input")
              = f.label(:status_action, t(".reject"), value: "reject", class: "form-check-label")

      - unless entry.report.status == :approved
        %div{class: "#{'hidden' if entry.status_action == 'keep'}", data: { "field-visibility-target": "container" }}
          = f.labeled_collection_select(:mail_recipient_id, entry.possible_mail_recipients, :id, :full_name, {include_blank: true}, class: "form-select#{" is-invalid" if entry.errors[:mail_recipient_id].any?}")
