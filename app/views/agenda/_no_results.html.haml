-# locals: group:
.agenda-no-results.bg-white
  = agenda_icon(:search_x, class: "agenda-icon-lg")
  %div
    %p.agenda-no-results-title.mb-0= t("agenda.list.no_results.title")
    %p.mt-1.mb-0.small.text-muted= t("agenda.list.no_results.subtitle")
  = link_to t("agenda.index.reset_filter"),
      agenda_index_path(group_id: group.id),
      class: "btn btn-sm agenda-btn-cta agenda-btn-outline", data: {turbo: false}
