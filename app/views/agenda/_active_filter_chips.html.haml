-# locals: event_filter:, group:
- chips = active_filter_chips(event_filter, group)
- if chips.any?
  .agenda-active-filter-chips.bg-white.border.shadow-sm.mb-3.d-flex.flex-wrap.align-items-center.justify-content-between.gap-2
    .d-flex.flex-wrap.gap-2
      - chips.each do |chip|
        = link_to chip[:path], class: "agenda-filter-chip", data: {turbo_frame: :agenda_events_list} do
          = chip[:label]
          = agenda_icon(:x, css_class: "agenda-icon-sm")
    = link_to agenda_index_path(group_id: group.id),
        class: "agenda-btn-ghost d-inline-flex align-items-center gap-1", data: {turbo_frame: :agenda_events_list} do
      = agenda_icon(:"rotate-ccw")
      = t("agenda.index.reset_all_filters")
