-# locals: event_filter:, group:
- chips = active_filter_chips(event_filter, group)
- if chips.any?
  .d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.mb-3
    .d-flex.flex-wrap.gap-2
      - chips.each do |chip|
        = link_to chip[:path], class: "agenda-chip", data: {turbo_frame: :agenda_events_list} do
          = chip[:label]
          = icon(:times)
    = link_to t("agenda.index.reset_all_filters"), agenda_index_path(group_id: group.id),
        class: "small text-muted", data: {turbo_frame: :agenda_events_list}
