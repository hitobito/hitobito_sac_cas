.agenda-tour-detail-header
  .d-flex.align-items-start.justify-content-between.gap-3
    .flex-grow-1.overflow-hidden
      - if event.tour?
        .d-flex.flex-wrap.align-items-center.gap-2
          - event.activities.each do |activity|
            %span.agenda-activity-header-icon{style: ("--activity-color: #{activity.parent.color}" if activity.parent&.color.present?)}
              = agenda_activity_icon(activity)
            %span.agenda-tour-detail-type= activity.label.upcase
          - tour_activity_requirements(event).each do |activity, requirements|
            - requirements.each do |requirement|
              %span.agenda-tour-detail-header-badge{style: ("--bs-badge-color: #{activity.parent.color};" if activity.parent&.color.present?)}
                = requirement.label

      %h2.agenda-tour-detail-title= event.name
