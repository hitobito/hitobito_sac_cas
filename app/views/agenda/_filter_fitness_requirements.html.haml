- selected = Array(event_filter.chain.dig(:tour_essentials, :fitness_requirement_id))

= render layout: "filter_dropdown_shell",
    locals: {label: t("agenda.filters.fitness_requirements"), icon_name: :activity, count: selected.size} do
  - @fitness_requirements.each do |requirement|
    = render "filter_checkbox_option",
        value: requirement,
        selected: selected,
        field_name: 'filters[tour_essentials][fitness_requirement_id][]',
        string_format: :long

