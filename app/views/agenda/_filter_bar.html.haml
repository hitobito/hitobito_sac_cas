-# locals: f: (the agenda index form builder)
.agenda-filter-bar.bg-white.border.rounded.shadow-sm.p-3.mb-3
  .d-flex.flex-wrap.gap-3.align-items-end.mb-3
    = render "agenda/date_filters", f: f
    = render "agenda/search_filter_stub"

  .d-flex.flex-wrap.gap-2.align-items-center
    = render "agenda/target_group_filter", target_groups: @target_groups
    = render "agenda/activities_filter", activities: @activities
    = render "agenda/fitness_requirement_filter", fitness_requirements: @fitness_requirements
    = render "agenda/application_filters", f: f
    = render "agenda/stub_filters"

    .ms-auto.d-flex.gap-2
      = submit_button(f, t("global.button.search"), name: nil)
      %button.btn.btn-sm.btn-outline-primary.mt-2{type: "button",
          data: {action: "click->sac-cas--agenda-filters#reset"}}
        = t("agenda.index.reset_filter")
