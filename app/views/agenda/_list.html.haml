= turbo_frame_tag(filter_frame_id, target: :_top) do
  = render "active_filter_chips", event_filter: event_filter, group: group
  = render "results_summary", count: events.total_count

  - if events.any?
    = render "event_cards", events: events
    = render "pagination_sentinel", events: events
  - else
    = render "no_results", group: group
