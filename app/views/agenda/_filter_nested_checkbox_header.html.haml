-# Parent (Hauptkategorie) row for a nested checkbox filter group: a
-# tri-state checkbox that selects/clears all of this group's children (see
-# sac-cas--checkbox-filter#toggleParent), plus an optional colour swatch
-# and the group's label.
-#
-# locals: dom_id:, label:, color: nil
- color = local_assigns[:color]
- regular = local_assigns[:regular] || false

.form-check.agenda-filter-option
  = check_box_tag(nil, "1", false, id: dom_id, class: "form-check-input",
      data: {action: "change->sac-cas--checkbox-filter#toggleParent",
             "sac-cas--checkbox-filter-target": "parent"})
  - if color.present?
    %span.agenda-activity-swatch{style: "background-color: #{color}", "aria-hidden": "true"}
  = label_tag(dom_id, label, class: "form-check-label #{'fw-bold' unless regular}")
