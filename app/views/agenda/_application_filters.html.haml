.d-flex.align-items-center.gap-2
  = f.fields_for(:application_open) do |ff|
    %span.small.text-muted= t(".application_open")
    .btn-group{role: "group"}
      = ff.radio_button(:value, 1, checked: event_filter.chain.dig(:application_open, :value) == "1", class: "btn-check")
      = ff.label(:value, t("global.yes"), value: 1, class: "btn btn-outline-secondary btn-sm")
      = ff.radio_button(:value, 0, checked: event_filter.chain.dig(:application_open, :value) != "1", class: "btn-check")
      = ff.label(:value, t("global.no"), value: 0, class: "btn btn-outline-secondary btn-sm")

- if show_places_available_filter?(group)
  .d-flex.align-items-center.gap-2
    = f.fields_for(:places_available) do |ff|
      %span.small.text-muted= t(".places_available")
      .btn-group{role: "group"}
        = ff.radio_button(:value, 1, checked: event_filter.chain.dig(:places_available, :value) == "1", class: "btn-check")
        = ff.label(:value, t("global.yes"), value: 1, class: "btn btn-outline-secondary btn-sm")
        = ff.radio_button(:value, 0, checked: event_filter.chain.dig(:places_available, :value) != "1", class: "btn-check")
        = ff.label(:value, t("global.no"), value: 0, class: "btn btn-outline-secondary btn-sm")
