-# Aktivitäten filter: one fieldset per main activity, its
-# children nested underneath with tri-state parent selection.
-# A activity whose single activity shares its label skips that
-# redundant nesting - the fieldset still gets the activity's swatch and
-# bold label, but the checkbox itself is the activity's, see
-# _filter_activity_option's `color` local. A activity without any activities at
-# all isn't rendered as a group either. Checking an activity reveals its
-# linked technical requirement as a toggleable chip - see
-# sac-cas--activity-chips and _filter_activity_option.
-#
-# locals: activities: [Event::Activity, ...] (mains and children, unsorted)
- selected = Array(event_filter.chain.dig(:tour_essentials, :activity_id))

= render layout: "filter_dropdown_shell",
    locals: {label: t("agenda.filters.activities"), icon_name: "mountain",
             count: selected.size, extra_controller: "sac-cas--activity-chips"} do
  - activities.select(&:main?).each_with_index do |main, index|
    - children = activities.select { |activity| activity.parent_id == main.id }
    - if children.empty?
      = render "filter_activity_option", activity: main, selected: selected
    - else
      %fieldset.agenda-filter-group{class: ("mt-2 pt-2 border-top" if index.positive?)}
        %legend.visually-hidden= main.label
        - if children.one? && children.first.label == main.label
          = render "filter_activity_option", activity: children.first, selected: selected, color: main.color
        - else
          = render "filter_nested_checkbox_header", dom_id: "activity_group_#{main.id}", label: main.label, color: main.color
          .ms-4
            - children.each do |child|
              = render "filter_activity_option", activity: child, selected: selected
