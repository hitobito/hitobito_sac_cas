- selected = Array(event_filter.chain.dig(:agenda_type, :values))

= render layout: "filter_dropdown_shell",
    locals: {label: t("agenda.filters.type"), icon_name: :type, count: selected.size} do
  - Events::Filter::AgendaType::OPTIONS.each do |option|
    = render "filter_checkbox_option",
        value: option,
        selected: selected,
        field_name: 'filters[agenda_type][values][]'


