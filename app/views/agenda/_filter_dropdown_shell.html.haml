-# Shared shell for a filter rendered as a Bootstrap dropdown: an icon/label
-# button showing a selected-count badge, opening a menu that stays open
-# while checkboxes inside are toggled (data-bs-auto-close="outside").
-# Counting/reset behaviour comes from the sac-cas--checkbox-filter Stimulus
-# controller; pass `extra_controller` to layer on filter-specific behaviour
-# (e.g. the Aktivitäten chip logic). Yields the checkbox list content.
-#
-# locals: label:, icon_name: nil, count: 0, disabled: false, extra_controller: nil
- controllers = ["sac-cas--checkbox-filter", local_assigns[:extra_controller]].compact.join(" ")
- disabled ||= false
- count ||= 0

.dropdown.agenda-filter-dropdown{data: (disabled ? {} : {controller: controllers})}
  %button.btn.btn-outline-secondary.dropdown-toggle{type: "button", disabled: disabled,
      data: (disabled ? {} : {bs_toggle: "dropdown", bs_auto_close: "outside"})}
    - if icon_name
      = icon(icon_name)
    = label
    %span.badge.rounded-pill.bg-secondary.ms-1{class: ("d-none" if count.zero?),
        data: {"sac-cas--checkbox-filter-target": "counter"}}
      = count
  - unless disabled
    .dropdown-menu.p-3
      = yield
      %a.small{href: "#", class: ("d-none" unless count.positive?),
          data: {action: "click->sac-cas--checkbox-filter#reset",
                 "sac-cas--checkbox-filter-target": "resetLink"}}
        = t("agenda.filters.reset")
