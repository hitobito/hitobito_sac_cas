- if event.contact && event.visible_contact_attributes.present?
  - contact = event.contact
  .agenda-tour-detail-contact.d-flex.flex-column.gap-2
    %h4.agenda-section-title= t("agenda.show.contact")
    .agenda-contact-profile
      - if agenda_contact_attr_visible?(event, :picture) && contact.picture.attached?
        = image_tag contact.picture.variant(resize_to_fill: [128, 128]),
          class: "agenda-contact-avatar", alt: contact.to_s
      - else
        .agenda-contact-avatar.agenda-contact-avatar-initials= person_initials(contact)

      .agenda-contact-body
        - if agenda_contact_attr_visible?(event, :name)
          .fw-bold= contact.to_s

        - if agenda_contact_attr_visible?(event, :address)
          .agenda-contact-detail
            = agenda_icon(:map_pin)
            %span= event.decorate.contact_address

        - if agenda_contact_attr_visible?(event, :phone_number)
          - agenda_contact_phone_numbers(contact).each do |number|
            %a.agenda-contact-detail{href: "tel:#{number.gsub(/\s/, "")}"}
              = agenda_icon(:phone)
              = number

        - if agenda_contact_attr_visible?(event, :email)
          - agenda_contact_emails(contact).each do |email|
            %a.agenda-contact-detail.agenda-contact-detail-email{href: "mailto:#{email}"}
              = agenda_icon(:mail)
              = email

        - if agenda_contact_attr_visible?(event, :social_account)
          - agenda_contact_social_accounts(contact).each do |account|
            .agenda-contact-detail
              = agenda_icon(:link)
              = muted(account.translated_label)
              %span= auto_link_value(account.value)
