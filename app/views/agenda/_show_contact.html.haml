- leader_participations = event_leader_participations(event)
- if leader_participations.any?
  .agenda-tour-detail-leaders.d-flex.flex-column.gap-2
    %h4.agenda-section-title= t("agenda.show.leaders")
    - leader_participations.each_with_index do |participation, index|
      - person = participation.person
      .agenda-leader-profile{class: ("agenda-leader-profile-highlight" if index.zero?)}
        - if person.picture.attached?
          = image_tag person.picture.variant(resize_to_fill: [128, 128]),
            class: "agenda-leader-avatar", alt: person.to_s
        - else
          .agenda-leader-avatar.agenda-leader-avatar-initials= person_initials(person)

        .min-w-0.flex-grow-1
          .fw-bold= person.to_s
          - leader_role = participation.roles.find { |role| event.class.leader_types.include?(role.class) }
          - if leader_role
            .agenda-leader-role= leader_role.to_s

          - phone = person.phone_numbers.first&.number
          - if phone.present? || person.email.present?
            .d-flex.flex-column.gap-1.mt-2
              - if phone.present?
                %a.agenda-leader-contact{href: "tel:#{phone.gsub(/\s/, '')}"}
                  = agenda_icon(:phone)
                  = phone
              - if person.email.present?
                %a.agenda-leader-contact.agenda-leader-contact-email{href: "mailto:#{person.email}"}
                  = agenda_icon(:mail)
                  = person.email
