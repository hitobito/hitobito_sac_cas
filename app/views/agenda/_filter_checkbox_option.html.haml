-# locals: field_name: string, value: Object, selected: [], string_format: Symbol
- dom_id = "#{field_name.parameterize}-#{value.id}"
- string_format ||= nil

.form-check.agenda-filter-option
  = check_box_tag(field_name,
      value.id,
      selected.include?(value.id),
      id: dom_id,
      class: "form-check-input",
      data: {action: "change->sac-cas--checkbox-filter#toggleOption",
             "sac-cas--checkbox-filter-target": "option"})
  = label_tag(dom_id, value.to_s(string_format), class: "form-check-label")
