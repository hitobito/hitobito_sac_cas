-# Kondition filter: flat checkbox list, no nesting.
-#
-# locals: fitness_requirements: [Event::FitnessRequirement, ...]
- selected = Array(event_filter.chain.dig(:tour_essentials, :fitness_requirement_id))

= render "agenda/checkbox_dropdown_filter",
    field_name: "filters[tour_essentials][fitness_requirement_id]",
    label: t("agenda.filters.fitness_requirements"),
    icon_name: "battery-three-quarters",
    options: fitness_requirements.map { |requirement| [requirement.id, requirement.label] },
    selected: selected
