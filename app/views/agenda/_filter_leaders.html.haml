-# locals: leaders: [Person, ...]
- selected = Array(event_filter.chain.dig(:leader, :ids)).map(&:to_i)

= render layout: "filter_dropdown_shell",
    locals: {label: t("agenda.filters.leader"), icon_name: :user, count: selected.size} do
  - leaders.each do |person|
    = render "filter_checkbox_option",
        value: person,
        selected: selected,
        field_name: 'filters[leader][ids][]',
        string_format: :list

