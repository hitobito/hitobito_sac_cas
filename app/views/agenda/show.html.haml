= link_to t("global.button.back"), agenda_index_path(group, returning: true), class: "btn btn-sm btn-outline-secondary mb-3"

.agenda-tour-card.border.rounded.bg-white.shadow-sm.p-4
  %h2= event.name

  %dl.row.mb-0
    %dt.col-sm-3= t("agenda.list.tour_card.date")
    %dd.col-sm-9= I18n.l(event.start_at)

    - if event.total_duration_days
      %dt.col-sm-3= t("agenda.list.tour_card.duration_label")
      %dd.col-sm-9= t("agenda.list.tour_card.duration", count: event.total_duration_days)

    - if event.display_booking_info?
      %dt.col-sm-3= t("agenda.list.tour_card.participants_label")
      %dd.col-sm-9= t("agenda.list.tour_card.participants", count: event.participant_count, max: event.maximum_participants)

    - if event.contact
      %dt.col-sm-3= t("agenda.list.tour_card.contact")
      %dd.col-sm-9= event.contact.to_s

    - if event.is_a?(Event::Tour)
      %dt.col-sm-3= Event::Activity.model_name.human(count: 2)
      %dd.col-sm-9= format_event_activities(event)

      %dt.col-sm-3= Event::TechnicalRequirement.model_name.human(count: 2)
      %dd.col-sm-9= format_event_technical_requirements(event)

      - if event.fitness_requirement
        %dt.col-sm-3= Event::FitnessRequirement.model_name.human
        %dd.col-sm-9= format_event_fitness_requirement(event)

      %dt.col-sm-3= Event::TargetGroup.model_name.human(count: 2)
      %dd.col-sm-9= format_event_target_groups(event)

      - if event.ascent || event.descent
        %dt.col-sm-3= t("agenda.list.tour_card.elevation")
        %dd.col-sm-9= "#{event.ascent} m / #{event.descent} m / #{event.duration_in_hours} h"
