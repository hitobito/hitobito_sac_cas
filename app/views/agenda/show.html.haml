.d-flex.flex-column.gap-3
  = render "show_back_link"

  -# The tour's accent colour is handed to the stylesheet once here; every
  -# element tinted by it reads --tour-color, with a neutral fallback for the
  -# event types that have no activity to take a colour from.
  - color = tour_accent_color(event)
  .agenda-tour-detail.bg-white.border.shadow-sm.overflow-hidden{style: ("--tour-color: #{color}" if color.present?)}
    = render "show_header"

    .agenda-tour-detail-body
      = render "show_badges"

      = render "show_facts"

      = render "show_details"

      = render "show_buttons"

    = render "show_notice"
