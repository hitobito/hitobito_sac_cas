-# Visual-only stub for the prototype's full-text search. Disabled input,
-# no field name, so nothing is ever submitted. Matches SearchInput.tsx: no
-# visible label (aria-label only), a gray search icon on the left, and its
-# exact placeholder text.
.position-relative.flex-grow-1.agenda-search-field
  = agenda_icon(:search, css_class: "agenda-search-field-icon")
  %input#agenda_search_stub.form-control.agenda-search-field-input{type: "search",
      placeholder: t("agenda.filters.search_placeholder"), "aria-label": t("agenda.filters.search")}
