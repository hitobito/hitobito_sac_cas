-# Visual-only stubs for the prototype's full-text search, leader search and
-# saved-filters popover - none have a backing filter yet. Disabled inputs,
-# no field name, so nothing is ever submitted.
.d-flex.flex-column
  %label.form-label{for: "agenda_search_stub"}= t("agenda.filters.search")
  %input#agenda_search_stub.form-control.form-control-sm{type: "search", disabled: true,
      placeholder: t("agenda.filters.search_placeholder")}

.d-flex.flex-column
  %label.form-label{for: "agenda_leader_search_stub"}= t("agenda.filters.leader_search")
  %input#agenda_leader_search_stub.form-control.form-control-sm{type: "search", disabled: true,
      placeholder: t("agenda.filters.leader_search_placeholder")}

%button.btn.btn-outline-secondary{type: "button", disabled: true}
  = icon(:bookmark)
  = t("agenda.filters.saved_filters")
