!!! 5

%html{lang: I18n.locale}
  %head
    %meta{charset: 'utf-8'}
    %title= "#{Settings.application.name} - #{title}"
    %meta{name: 'viewport', content: 'width=device-width, initial-scale=1.0'}

    = csrf_meta_tags
    = wagon_favicon_pack_tag 'favicon.ico'

    = javascript_pack_tag 'core', 'data-turbo-track': true
    = javascript_pack_tag 'agenda', 'data-turbo-track': true
    = stylesheet_pack_tag 'agenda', media: 'all', 'data-turbo-track': true

    = yield(:head)

  %body.agenda-body
    .agenda-header
      .agenda-container.d-flex.justify-content-between.align-items-end.flex-wrap.gap-2
        .agenda-header-title
          %h1= t("agenda.header.title")
          - if group.present?
            %p.text-muted.mb-0= group.name
        -# Dummy placeholder for the section's branding, until a real group
           logo is wired up here.
        .agenda-header-brand.text-end.small.text-muted
          = t("agenda.header.brand")

    #flash
      = render partial: 'layouts/flash', collection: [:notice, :warning, :alert], as: :level

    .agenda-container
      %main#main-content
        = yield
