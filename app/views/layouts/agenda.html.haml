!!! 5

%html{lang: I18n.locale}
  %head
    %meta{charset: 'utf-8'}
    %title= "#{Settings.application.name} - #{title}"
    %meta{name: 'viewport', content: 'width=device-width, initial-scale=1.0'}

    = csrf_meta_tags
    = wagon_favicon_pack_tag 'favicon.ico'

    = javascript_pack_tag 'core', 'data-turbo-track': true
    = javascript_pack_tag 'agenda', 'data-turbo-track': true
    = stylesheet_pack_tag 'agenda', media: 'all', 'data-turbo-track': true

    = yield(:head)

  %body.agenda-body
    .agenda-header
      .agenda-container.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
        .agenda-header-title
          %h1= t("agenda.header.title")
          - if group.present?
            %p.text-muted.mb-0= group.name
        .agenda-header-brand.text-end
          - if group && group.logo.attached?
            = image_tag(group.logo, alt: group.name)
          - else
            - logo = Settings.application.logo
            - path = logo&.dig(:multilanguage_image, I18n.locale) || logo&.image
            - url = url_to_asset(current_webpacker_instance.manifest.lookup!("media/images/#{path}"))
            = image_tag(url, alt: Settings.application.name)

    #flash
      = render partial: 'layouts/flash', collection: [:notice, :warning, :alert], as: :level

    .agenda-container
      %main#main-content
        = yield
