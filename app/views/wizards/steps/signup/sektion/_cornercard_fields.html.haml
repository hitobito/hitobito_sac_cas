= c.fields_for do |form|
  .align-with-form
    %h4.fw-bold= t('.benefit_heading')
    = wagon_image_pack_tag('cornercard-sac.png', alt: 'SAC-Cornèrcard', class: 'mb-3', style: 'width: 400px; height: auto')

  .align-with-form
    %h4.fw-bold= t('.order_heading')
    %p= t('.order_description')

    %h5.fw-bold= t('.benefits_heading')
    %ul.ps-3
      %li= t('.benefit_1')
      %li= t('.benefit_2')
      %li= t('.benefit_3')

    %p= t('.support_text').html_safe

  .align-with-form.mt-3
    = form.label(:card_application, class: 'd-block mt-2 checkbox form-check-label') do
      = form.check_box :card_application, class: "form-check-input"
      = t('.card_application_label')

    - data_link = link_to(t('.data_processing_link_text'), form.object.data_processing_url, target: :_blank)
    - agb_link = link_to(t('.agb_link_text'), form.object.agb_url, target: :_blank)
    = form.label(:consent_given, class: 'd-block mt-2 checkbox form-check-label') do
      = form.check_box :consent_given, class: "form-check-input"
      = t('.consent_label', data_processing_link: data_link, agb_link: agb_link).html_safe
