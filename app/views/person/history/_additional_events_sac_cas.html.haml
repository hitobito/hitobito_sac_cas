- if can?(:new, @person.external_trainings.build)
  - add_button = button_action_add(new_group_person_external_training_path(@group, @person))

= render layout: 'person/history/section',
  locals: { id: 'external_trainings',
            title: ExternalTraining.model_name.human(count: 2),
            actions: add_button } do
  = table(@external_trainings, class: 'table table-striped') do |t|
    - t.attrs(:event_kind, :name, :provider, :start_at, :finish_at, :training_days, :link, :remarks)
    - action_col_destroy(t) { |e| group_person_external_training_path(@group, @person, e) }
